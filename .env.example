# One provider is selected per message. Anthropic is the default.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Bedrock uses the normal AWS credential chain. Model or inference-profile IDs
# vary by region/account, so BEDROCK_MODEL_ID is required when selected.
AWS_REGION=us-east-1
AWS_PROFILE=
BEDROCK_MODEL_ID=

DATABASE_PATH=./data/triage.sqlite
LLM_TIMEOUT_MS=25000
LLM_MAX_ATTEMPTS=2
LLM_MAX_CONCURRENCY=3
