# One provider is selected per message. Anthropic is the default.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Bedrock provider is only available in the AWS region specified below.
# The model ID must be set to a valid Bedrock model.
AWS_REGION=us-east-1
AWS_PROFILE=
BEDROCK_MODEL_ID=

DATABASE_PATH=./data/triage.sqlite
# Selected-provider attempt timeout. A provider-specific value takes precedence.
LLM_TIMEOUT_MS=25000
ANTHROPIC_TIMEOUT_MS=30000
OPENAI_TIMEOUT_MS=30000
BEDROCK_TIMEOUT_MS=180000
# Hard deadline for all attempts and retry delays; at most 240000 ms and below
# the five-minute stale-run recovery threshold.
LLM_OVERALL_TIMEOUT_MS=240000
LLM_MAX_ATTEMPTS=2

# Server-side paid-operation admission controls.
TRIAGE_REQUESTS_PER_MINUTE=30
TRIAGE_REQUESTS_PER_DAY=500
